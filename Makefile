.PHONY: help up down logs migrate revision seed-demo test test-backend test-frontend e2e lint lint-backend lint-frontend vapid clean

SHELL := /bin/bash

help: ## Show available Makefile targets
	@echo "SpendWise Development Automation"
	@echo ""
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-18s\033[0m %s\n", $$1, $$2}'

up: ## Build and start all services via Docker Compose
	docker compose up --build -d

down: ## Stop and remove running Docker Compose containers
	docker compose down

logs: ## Follow Docker Compose logs across all services
	docker compose logs -f

migrate: ## Run database migrations using Alembic
	@if docker compose ps -q api 2>/dev/null | grep -q .; then \
		docker compose exec api alembic upgrade head; \
	else \
		cd backend && alembic upgrade head; \
	fi

revision: ## Generate a new autogenerated Alembic migration: make revision m="add table"
	@if docker compose ps -q api 2>/dev/null | grep -q .; then \
		docker compose exec api alembic revision --autogenerate -m "$(m)"; \
	else \
		cd backend && alembic revision --autogenerate -m "$(m)"; \
	fi

seed-demo: ## Seed demo account (demo@spendwise.app / demo1234) with sample INR transactions
	@if docker compose ps -q api 2>/dev/null | grep -q .; then \
		docker compose exec api python -m app.seed.demo_data; \
	elif [ -d "backend/.venv" ]; then \
		cd backend && .venv/bin/python -m app.seed.demo_data; \
	else \
		cd backend && python -m app.seed.demo_data; \
	fi

test: test-backend test-frontend ## Run all unit & integration test suites

test-backend: ## Run backend tests with pytest
	@if [ -d "backend/.venv" ]; then \
		source backend/.venv/bin/activate && pytest backend/tests; \
	else \
		pytest backend/tests; \
	fi

test-frontend: ## Run frontend tests with vitest
	cd frontend && npm test -- --run

e2e: ## Run Playwright end-to-end tests
	cd e2e && npx playwright test

lint: lint-backend lint-frontend ## Run static analysis and linting checks

lint-backend: ## Run Ruff linter and Mypy strict type-checker on backend
	@if [ -d "backend/.venv" ]; then \
		source backend/.venv/bin/activate && ruff check backend/app backend/tests && mypy --strict backend/app; \
	else \
		ruff check backend/app backend/tests && mypy --strict backend/app; \
	fi

lint-frontend: ## Run ESLint and TypeScript compiler checks on frontend
	cd frontend && npm run lint && npx tsc --noEmit

vapid: ## Generate a new VAPID cryptographic keypair for Web Push
	@python3 -c "import secrets; print('Generated Secrets:'); print('JWT_SECRET=' + secrets.token_urlsafe(48))"
	@python3 -c "from cryptography.hazmat.primitives.asymmetric import ec; from cryptography.hazmat.primitives import serialization; import base64; pk = ec.generate_private_key(ec.SECP256R1()); pub = pk.public_key(); raw_pub = pub.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint); raw_priv = pk.private_numbers().private_value.to_bytes(32, 'big'); print('VAPID_PUBLIC_KEY=' + base64.urlsafe_b64encode(raw_pub).decode().rstrip('=')); print('VAPID_PRIVATE_KEY=' + base64.urlsafe_b64encode(raw_priv).decode().rstrip('='))" 2>/dev/null || python3 -c "print('Install cryptography or pywebpush to generate VAPID keys.')"

clean: ## Remove temporary build and cache files
	find . -type d -name "__pycache__" -exec rm -rf {} +
	find . -type d -name ".pytest_cache" -exec rm -rf {} +
	find . -type d -name ".mypy_cache" -exec rm -rf {} +
	find . -type d -name ".ruff_cache" -exec rm -rf {} +
	rm -rf frontend/dist frontend/node_modules/.vite
