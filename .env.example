# ==============================================================================
# SpendWise Environment Configuration Template (.env.example)
# Copy to .env and configure appropriate values for your deployment.
# ==============================================================================

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://spendwise:spendwise@db:5432/spendwise
POSTGRES_USER=spendwise
POSTGRES_PASSWORD=spendwise
POSTGRES_DB=spendwise
POSTGRES_PORT=5432

# Backend Security & Tokens
JWT_SECRET=change-me-to-a-long-random-high-entropy-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Network & CORS
FRONTEND_ORIGIN=http://localhost:5173
PORT=8000
ENV=development
LOG_LEVEL=INFO

# Web Push (VAPID) - Generate with: make vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@spendwise.in

# Frontend Client Configuration (Vite injects VITE_ prefixed variables)
VITE_API_URL=http://localhost:8000/api/v1
VITE_VAPID_PUBLIC_KEY=
